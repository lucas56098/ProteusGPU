#!/usr/bin/env bash
# Stops a commit whose staged .cu or .h files are not formatted with clang-format (version 21, as in CI).
# Checks the staged content, not the file on disk. Install once with: git config core.hooksPath .githooks

set -u

CLANG_FORMAT="${CLANG_FORMAT:-clang-format}"
if ! command -v "$CLANG_FORMAT" > /dev/null; then
    echo "pre-commit: $CLANG_FORMAT not found, the format is not checked" >&2
    exit 0
fi

unformatted=""
for file in $(git diff --cached --name-only --diff-filter=ACM -- '*.cu' '*.h' ':!tests/doctest.h'); do
    if ! git show ":$file" | "$CLANG_FORMAT" --assume-filename="$file" --dry-run --Werror > /dev/null 2>&1; then
        unformatted="$unformatted $file"
    fi
done

[ -z "$unformatted" ] && exit 0

echo "pre-commit: not formatted:$unformatted" >&2
echo "fix with: $CLANG_FORMAT -i$unformatted && git add$unformatted" >&2
exit 1
